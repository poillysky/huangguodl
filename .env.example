# Upstream
HG_API=https://huangguoai.com
COVER_PROXY=https://ai.wulii.de5.net
COVER_TOKEN=

# Local HTTP proxy for upstream (Clash/V2Ray etc.)
# HTTP_PROXY=http://127.0.0.1:7890

# Backend auth (leave empty to disable in local/dev)
API_TOKEN=change-me

# Paths (relative to repo root, not the process cwd)
OUT_DIR=downloads
DATA_DIR=data

# Download concurrency
# WORKERS=3                 # 单任务内线程池
# MAX_PARALLEL_TASKS=2      # 同时进行的下载任务数
# MAX_GLOBAL_WORKERS=4      # 跨任务分集下载总并发

# Compose
WEB_PORT=8080
