# ========== 镜像 ==========
DOCKERHUB_USER=poillysky
IMAGE_TAG=latest

# ========== 端口（浏览器访问 http://NAS_IP:WEB_PORT）==========
WEB_PORT=8080
TZ=Asia/Shanghai

# ========== 宿主机路径（按 NAS 改）==========
# 群晖示例：
#   HOST_DOWNLOADS=/volume1/media/huangguo
#   HOST_CONFIG=/volume1/docker/huangguodl/config
# 威联通 / 飞牛 / 绿联类似，改成实际共享文件夹路径
HOST_DOWNLOADS=./data/downloads
HOST_CONFIG=./data/config

# ========== 上游 ==========
HG_API=https://huangguoai.com
COVER_PROXY=https://ai.wulii.de5.net
COVER_TOKEN=

# NAS 若需走代理访问上游 API（容器内地址，不是 127.0.0.1）
# 例：HTTP_PROXY=http://172.17.0.1:7890
HTTP_PROXY=

# ========== 访问鉴权（建议生产开启）==========
# 留空 = 不鉴权；设置后前端/API 需带 Bearer
API_TOKEN=

# ========== 下载并发（NAS 建议略保守）==========
WORKERS=3
MAX_PARALLEL_TASKS=2
MAX_GLOBAL_WORKERS=4
