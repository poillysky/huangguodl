# ========== 镜像 ==========
DOCKERHUB_USER=poillysky
IMAGE_TAG=latest

# ========== 端口（浏览器访问 http://NAS_IP:WEB_PORT）==========
WEB_PORT=8080
TZ=Asia/Shanghai

# ========== 宿主机路径 ==========
# Compose / 配置放：/vol1/1000/Docker/huangguodl
# 下载落到 115 上传同步目录
HOST_DOWNLOADS=/vol1/1000/Sync/115上传/黄果
HOST_CONFIG=/vol1/1000/Docker/huangguodl/config

# ========== 上游 ==========
HG_API=https://huangguoai.com
COVER_PROXY=https://ai.wulii.de5.net
COVER_TOKEN=

# NAS 若需走代理访问上游 API（容器内地址，不是 127.0.0.1）
# 例：HTTP_PROXY=http://172.17.0.1:7890
HTTP_PROXY=

# ========== 访问鉴权（建议生产开启）==========
API_TOKEN=

# ========== 下载并发（NAS 建议略保守）==========
WORKERS=3
MAX_PARALLEL_TASKS=2
MAX_GLOBAL_WORKERS=4
